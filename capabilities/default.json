{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main Antigravity window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:path:default",
    "fs:default",
    "shell:default",
    "dialog:default",
    "clipboard-manager:default",
    "notification:default",
    "global-shortcut:default",
    "updater:default",
    "positioner:default"
  ]
}
